{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "del ./.parcel-cache && npm run clean --workspaces",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@parcel/optimizer-data-url": "^2.16.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "husky": "^9.1.7",
    "stream-browserify": "^3.0.0",
    "typescript": "^6.0.3",
    "vm-browserify": "^1.1.2"
  },
  "dependencies": {
    "del-cli": "^7.0.0",
    "docx-preview": "^0.3.7",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "rtf.js": "^3.0.9",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  }
}
