{
  "name": "@webexplorer/gtp",
  "version": "0.1.0",
  "description": "gtp parser",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types"
  ],
  "scripts": {
    "build": "parcel build",
    "clean": "del-cli --force dist .parcel-cache",
    "postbuild": "npm run copy-types",
    "copy-types": "cpy ./dist/types/* ./dist/cjs --flat && cpy ./dist/types/* ./dist/esm --flat",
    "test": "tape"
  },
  "keywords": [
    "gtp",
    "parser"
  ],
  "author": "Ji Chang",
  "license": "MIT",
  "dependencies": {
    "@webexplorer/archive": "^0.1.0",
    "@webexplorer/common": "^0.1.0",
    "del-cli": "^5.1.0",
    "parcel": "^2.12.0",
    "typescript": "^5.4.5"
  }
}