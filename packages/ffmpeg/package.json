{
  "name": "@webexplorer/ffmpeg",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "FFmpeg webassebmly for web platform",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ffmpeg.wasm": {
      "import": "./dist/esm/ffmpeg.cacb9e22.wasm",
      "require": "./dist/cjs/ffmpeg.cacb9e22.wasm"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "parcel ./index.html --no-hmr",
    "build": "parcel build",
    "clean": "del-cli --force dist .parcel-cache",
    "postbuild": "npm run copy-types",
    "copy-types": "cpy src/ffmpeg.d.ts dist/types/ --flat && cpy ./dist/types/* ./dist/cjs --flat && cpy ./dist/types/* ./dist/esm --flat",
    "build:wasm": "make && cpy ./docker/src/ffmpeg.js ./src --flat && cpy ./docker/src/ffmpeg.wasm ./src --flat",
    "build:all": "npm run build:wasm && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichang/ffmpeg-web.git"
  },
  "keywords": [
    "FFmpeg",
    "FFprobe",
    "webassembly"
  ],
  "files": [
    "src/cjs",
    "src/esm",
    "src/types"
  ],
  "author": "Ji Chang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jichang/ffmpeg-web/issues"
  },
  "homepage": "https://github.com/jichang/ffmpeg-web#readme",
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.1",
    "@parcel/transformer-typescript-types": "^2.16.1",
    "buffer": "^6.0.3",
    "comlink": "^4.4.2",
    "cpy-cli": "^6.0.0",
    "crypto-browserify": "^3.12.1",
    "del-cli": "^7.0.0",
    "jest": "^30.2.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/emscripten": "^1.41.5",
    "parcel": "^2.16.1"
  }
}