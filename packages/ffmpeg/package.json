{
  "name": "@webexplorer/ffmpeg",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "FFmpeg webassebmly for web platform",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "serve",
    "build": "parcel build",
    "postbuild": "cpy src/ffmpeg.d.ts dist/types/ --flat",
    "build:wasm": "make",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jichang/ffmpeg-web.git"
  },
  "keywords": [
    "FFmpeg",
    "FFprobe",
    "webassembly"
  ],
  "files": [
    "src/cjs",
    "src/esm",
    "src/types"
  ],
  "author": "Ji Chang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jichang/ffmpeg-web/issues"
  },
  "homepage": "https://github.com/jichang/ffmpeg-web#readme",
  "devDependencies": {
    "@parcel/packager-ts": "^2.12.0",
    "@parcel/transformer-typescript-types": "^2.12.0",
    "@types/jest": "^29.5.12",
    "buffer": "^6.0.3",
    "comlink": "^4.4.1",
    "cpy-cli": "^5.0.0",
    "crypto-browserify": "^3.12.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "serve": "^14.2.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@types/emscripten": "^1.39.10",
    "parcel": "^2.12.0"
  }
}