{
  "name": "@webexplorer/archive",
  "version": "0.1.0",
  "description": "libarchive ported to wasm",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./libarchive.wasm": {
      "import": "./dist/esm/libarchive.aca5a88e.wasm",
      "require": "./dist/cjs/libarchive.aca5a88e.wasm"
    }
  },
  "scripts": {
    "clean": "del-cli --force dist .parcel-cache",
    "build": "parcel build",
    "postbuild": "npm run copy-types",
    "copy-types": "cpy ./src/libarchive.d.ts ./dist/types --flat && cpy ./dist/types/* ./dist/cjs --flat && cpy ./dist/types/* ./dist/esm --flat",
    "build:wasm": "./scripts/wasm.sh && cp -r ./scripts/output/libarchive.* ./src"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exploreronweb/webexplorer.git"
  },
  "keywords": [
    "Archive",
    "Wasm",
    "Zip",
    "Rar"
  ],
  "author": "Ji Chang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exploreronweb/webexplorer/issues"
  },
  "homepage": "https://github.com/exploreronweb/webexplorer#readme",
  "dependencies": {
    "@types/emscripten": "^1.40.1",
    "cpy-cli": "^5.0.0",
    "del-cli": "^6.0.0",
    "parcel": "^2.15.2",
    "typescript": "^5.8.3"
  }
}