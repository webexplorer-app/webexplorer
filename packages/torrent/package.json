{
  "name": "@webexplorer/torrent",
  "version": "0.1.0",
  "description": "torrent file parser",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types"
  ],
  "scripts": {
    "clean": "del-cli --force dist .parcel-cache",
    "build": "parcel build",
    "postbuild": "npm run copy-types",
    "copy-types": "cpy ./dist/types/* ./dist/cjs --flat && cpy ./dist/types/* ./dist/esm --flat"
  },
  "keywords": [
    "torrent",
    "file",
    "parser"
  ],
  "author": "Ji Chang",
  "license": "MIT",
  "dependencies": {
    "@types/tape": "^5.8.1",
    "@webexplorer/common": "^0.1.0",
    "del-cli": "^7.0.0",
    "parcel": "^2.16.4",
    "tape": "^5.9.0",
    "typescript": "^5.9.3"
  }
}