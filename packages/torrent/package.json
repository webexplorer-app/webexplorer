{
  "name": "@webexplorer/torrent",
  "version": "0.1.0",
  "description": "torrent file parser",
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
