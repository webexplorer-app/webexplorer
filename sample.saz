<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Joe Turner is a software developer from Leicester"><link rel="icon" href="/favicon.ico"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/favicon-180.png"><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#CF0000"><title>Joe Turner</title><style>@font-face{font-family:'League Spartan';src:url(/fonts/league-spartan/LeagueSpartan-VF.woff2) format('woff2-variations');font-weight:200 900}*{box-sizing:border-box}html{font-family:"League Spartan",sans-serif;font-size:40px;line-height:1.35;font-variation-settings:"wght" 700;max-width:100vw;overflow-x:hidden}body{margin:0;background-color:#f5f5f5;max-width:1920px;width:100%}a{color:#cf0000;text-decoration:none;transition:box-shadow .1s linear}a.image-link:hover{box-shadow:none}a:focus{outline:0}a:focus,a:hover{box-shadow:0 10px 0 0 #85cee0}#fun-things:hover{box-shadow:none}#fun-things:focus{outline:0}ul{list-style-type:none;padding:0}p,ul{margin:24px 0}p:last-child{margin-bottom:0}.index-main{font-size:40px;padding:30px}.top-bar{overflow:hidden;min-height:100px;position:absolute;top:-100px;left:0;right:0;transition:top ease-in-out .5s}.top-bar-open{top:0}.top-bar-image{margin-left:50%;transform:translateX(-50%);display:none}.top-bar-image-open{display:block}.index-title{font-size:40px;margin:0;text-align:right;line-height:37px;margin-bottom:40px}.index-title-span{background-color:#f5f5f5;position:relative;z-index:1}.index-subtitle{font-size:20px;margin:5px 0;text-align:right}.index-subtitle .button-link:hover{box-shadow:0 6px 0 0 #85cee0}#fun-things:hover{box-shadow:none}.button-link{font-family:inherit;font-size:inherit;font-variation-settings:inherit;background:0 0;border:none;padding:0;color:#cf0000;cursor:pointer;transition:box-shadow .1s ease-in-out}.button-link:focus{outline:0}.button-link:focus,.button-link:hover{box-shadow:0 10px 0 0 #85cee0}@media (min-width:576px){.main-nav-list{display:flex;justify-content:space-around}}@media (min-width:992px){.index-main{max-width:992px;margin:auto}}</style></head><body><main class="index-main"><p>Sorry, we couldn't find the page you're looking for. Try heading back to the <a href="/">home page</a>.</p></main></body></html>